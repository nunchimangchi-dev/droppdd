// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Workout {
  id           String     @id
  title        String
  description  String
  duration     String
  intensity    String
  category     String
  target       String
  caloriesBurn Int
  exercises    Exercise[]
}

model Exercise {
  id        Int      @id @default(autoincrement())
  name      String
  sets      Int
  reps      String
  rest      String
  notes     String?
  workoutId String
  workout   Workout  @relation(fields: [workoutId], references: [id])
}

model Meal {
  id           String   @id
  title        String
  description  String
  calories     Int
  protein      Int
  fat          Int
  netCarbs     Int
  category     String
  ingredients  Json
  instructions Json
}

model WeightRecord {
  id     Int      @id @default(autoincrement())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date   String // display string (e.g. "Aug 25") - kept for existing render code
  recordedAt DateTime @default(now()) // real timestamp - source of truth for streak/consecutive-day math
  weight Float
}

// One row per user (queried with findFirst({ where: { userId } })), not
// enforced with @@unique here since nothing today creates a second row.
model Progress {
  id             Int     @id @default(autoincrement())
  userId         String
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentStreak  Int
  bestStreak     Int
  targetWeight   Float
  currentWeight  Float
  startWeight    Float
  age            Int?
  heightInches   Float?
  mealPreference String? // "CARNIVORE" | "VEGETARIAN" | "NO_PREFERENCE"
}

model AllowedEmail {
  id      Int     @id @default(autoincrement())
  email   String  @unique
  isAdmin Boolean @default(false)
}

model User {
  id               String    @id @default(cuid())
  username         String?   @unique
  name             String?
  email            String?   @unique
  emailVerified    DateTime?
  image            String?
  termsAcceptedAt  DateTime?
  lastAiMealGeneratedAt DateTime? // cooldown guard - real billed Anthropic API calls on a dedicated key
  accounts         Account[]
  sessions         Session[]
  wagers           Wager[]        @relation("WagerCreator")
  wagersChallenged Wager[]        @relation("WagerChallenged")
  progress         Progress[]
  weightRecords    WeightRecord[]
  boardItems       BoardItem[]
  inviteRequests   InviteRequest[]
  dailyCheckIns    DailyCheckIn[]
}

// Phase 1 (docs/FUTURE-WAGERS.md): solo commitment contracts, honor system,
// no real money. "metric" is deliberately limited to values resolvable from
// data already tracked elsewhere in this schema (Progress, WeightRecord) -
// no new logging infrastructure, and no metric type gets added here until
// there's real tracked data to resolve it against:
//   - WEIGHT_TARGET: resolved against WeightRecord / Progress.currentWeight
//   - STREAK_TARGET: resolved against Progress.currentStreak
// Aggressiveness guardrails (e.g. capping WEIGHT_TARGET to a safe rate of
// loss for the given date range) are an application-layer concern for
// whatever builds the creation flow, not enforced at the schema level.
//
// Phase 2 (docs/FUTURE-WAGERS.md): peer challenges. challengedUserId null
// means a solo wager (unchanged from phase 1). When set, the wager starts
// PENDING with no startValue - the challenger proposes a target, but the
// baseline can only be captured from the challenged user's own Progress
// once they accept (you can't snapshot their streak before they agree to
// the bet). Same two metrics only - no free-text/custom goals.
model Wager {
  id               Int       @id @default(autoincrement())
  userId           String
  user             User      @relation("WagerCreator", fields: [userId], references: [id], onDelete: Cascade)
  challengedUserId String?
  challengedUser   User?     @relation("WagerChallenged", fields: [challengedUserId], references: [id], onDelete: Cascade)
  title            String
  metric           String // "WEIGHT_TARGET" | "STREAK_TARGET"
  startValue       Float? // baseline captured at creation (solo) or acceptance (peer challenge)
  targetValue      Float
  stakeDescription String // honor-system, symbolic - e.g. "$20 to Feeding America if I miss this"
  startDate        DateTime  @default(now())
  endDate          DateTime
  status           String    @default("ACTIVE") // "PENDING" | "ACTIVE" | "WON" | "LOST" | "REJECTED" | "CANCELLED"
  resolvedAt       DateTime?
  createdAt        DateTime  @default(now())
}

// Self-serve feedback board: any signed-in beta user can submit a card
// (bug, feature request, or discovery note). Status moves (NEW -> PLANNED
// -> IN_PROGRESS -> DONE) and deletion are admin-only - a tester can flag
// something, but only the maintainer decides where it stands, same
// separation of concerns as the admin panel's other operator-facing pages.
model BoardItem {
  id          String   @id @default(cuid())
  type        String // "BUG" | "FEATURE" | "DISCOVERY"
  title       String
  description String
  status      String   @default("NEW") // "NEW" | "PLANNED" | "IN_PROGRESS" | "DONE"
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Lightweight lead capture, not real invite automation. Two sources:
//  - "peer_wager": a signed-in user tried to challenge a username/email that
//    isn't a user yet (highest-intent - they already tried). invitedBy set.
//  - "self_request": a stranger asked in via the public /request-access form
//    (Turnstile-gated). invitedBy null.
// Admins see the pending list on /admin and manually provision + email the
// person out of band - no auto-send, no new email infrastructure.
model InviteRequest {
  id            String   @id @default(cuid())
  email         String
  note          String? // e.g. the callsign they tried, or a note from the requester
  source        String   @default("self_request") // "self_request" | "peer_wager"
  invitedById   String?
  invitedBy     User?    @relation(fields: [invitedById], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
}

// Replaces WeightRecord as the primary daily check-in vehicle. Weight
// logging stays on WeightRecord (untouched) and is now optional - this
// model is what actually drives the streak. Strength is 6 self-reported
// booleans rather than one "did strength" flag on purpose: it's real data
// for the planned AI workout-assist feature later ("I only have
// dumbbells, what should I skip?"), and self-report today doesn't block
// swapping in real tracking later - the boolean semantics (goal met
// today) are what any future automatic integration would also compute.
model DailyCheckIn {
  id                    String   @id @default(cuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkInDate           DateTime @default(now())
  strengthPushups       Boolean  @default(false)
  strengthSitups        Boolean  @default(false)
  strengthPullups       Boolean  @default(false)
  strengthFloorPress    Boolean  @default(false)
  strengthFloorOverhead Boolean  @default(false)
  strengthPlanks        Boolean  @default(false)
  movementMet           Boolean  @default(false)
  eatingMet             Boolean  @default(false)
  // A floating once-every-7-days pass - satisfies the streak for the day
  // without requiring strength/movement/eating. Not tied to a fixed
  // calendar day (e.g. always Sunday) - eligibility is computed from the
  // most recent restDay row, not a day-of-week check.
  restDay               Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
