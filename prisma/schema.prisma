// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Workout {
  id           String     @id
  title        String
  description  String
  duration     String
  intensity    String
  category     String
  target       String
  caloriesBurn Int
  exercises    Exercise[]
}

model Exercise {
  id        Int      @id @default(autoincrement())
  name      String
  sets      Int
  reps      String
  rest      String
  notes     String?
  workoutId String
  workout   Workout  @relation(fields: [workoutId], references: [id])
}

model Meal {
  id           String   @id
  title        String
  description  String
  calories     Int
  protein      Int
  fat          Int
  netCarbs     Int
  category     String
  ingredients  Json
  instructions Json
}

model WeightRecord {
  id     Int    @id @default(autoincrement())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  date   String
  weight Float
}

// One row per user (queried with findFirst({ where: { userId } })), not
// enforced with @@unique here since nothing today creates a second row.
model Progress {
  id             Int    @id @default(autoincrement())
  userId         String
  user           User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentStreak  Int
  bestStreak     Int
  targetWeight   Float
  currentWeight  Float
  startWeight    Float
}

model AllowedEmail {
  id    Int    @id @default(autoincrement())
  email String @unique
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  wagers        Wager[]
  progress      Progress[]
  weightRecords WeightRecord[]
}

// Phase 1 (docs/FUTURE-WAGERS.md): solo commitment contracts, honor system,
// no real money. "metric" is deliberately limited to values resolvable from
// data already tracked elsewhere in this schema (Progress, WeightRecord) -
// no new logging infrastructure, and no metric type gets added here until
// there's real tracked data to resolve it against:
//   - WEIGHT_TARGET: resolved against WeightRecord / Progress.currentWeight
//   - STREAK_TARGET: resolved against Progress.currentStreak
// Aggressiveness guardrails (e.g. capping WEIGHT_TARGET to a safe rate of
// loss for the given date range) are an application-layer concern for
// whatever builds the creation flow, not enforced at the schema level.
model Wager {
  id               Int       @id @default(autoincrement())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String
  metric           String // "WEIGHT_TARGET" | "STREAK_TARGET"
  startValue       Float // baseline captured at creation (e.g. starting weight, or streak at creation)
  targetValue      Float
  stakeDescription String // honor-system, symbolic - e.g. "$20 to Feeding America if I miss this"
  startDate        DateTime  @default(now())
  endDate          DateTime
  status           String    @default("ACTIVE") // "ACTIVE" | "WON" | "LOST" | "CANCELLED"
  resolvedAt       DateTime?
  createdAt        DateTime  @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
